# 이 파일을 복사해서 .env 로 만들고 값을 채우세요: cp .env.example .env

# 구글 시트 ID — 시트 URL 의 /d/ 와 /edit 사이 문자열
# 예) https://docs.google.com/spreadsheets/d/1AbCdEfG.../edit → 1AbCdEfG...
RE_SHEET_ID=

# 서비스 어카운트 키 JSON 파일 경로 (README 의 "구글 서비스 어카운트 만들기" 참고)
RE_SHEETS_KEY_JSON=

# 1이면 시트에 실제로 쓰지 않고 결과만 확인(dry-run). 실제로 쓰려면 반드시 0.
RE_DRY_RUN=1
